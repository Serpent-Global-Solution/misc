# Copy to .env and fill in real values:  cp .env.example .env
# docker compose reads .env from this folder automatically. Never commit .env.

# --- Public domains (must resolve to the VM's public IP) ---
API_DOMAIN=api.example.com
AUTH_DOMAIN=auth.example.com
ACME_EMAIL=you@example.com

# --- OCI managed Postgres (shared by API and Keycloak; two DBs on one managed
#     instance — this is NOT a container in docker-compose.yml, see
#     deployment-doc.md §3.2 and backup-restore-runbook.md §1 for provisioning) ---
MANAGED_DB_HOST=your-instance.postgresql.oci.oraclecloud.com
MANAGED_DB_PORT=5432
MANAGED_DB_ADMIN_USERNAME=user
MANAGED_DB_ADMIN_PASSWORD=change-me-strong
MANAGED_DB_NAME=meikigo
# NOTE: the second database "meikigo-keycloak" has no auto-create hook on a managed
# instance — it is a one-time manual `CREATE DATABASE` step, see the runbook §1.

# --- Keycloak bootstrap admin (only used on first run against an empty DB) ---
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me-strong

# --- API <-> Keycloak admin client ---
KEYCLOAK_ADMIN_CLIENT_SECRET=change-me

# --- API ---
# Applies any pending EF Core migration at container startup (replaces the old
# JPA_DDL_AUTO=update — meikigo-api is .NET/EF Core, not Hibernate; see
# deployment-doc.md §6 and meikigo-api/src/Meikigo.Api/Program.cs).
DB_AUTO_MIGRATE=true
# Comma-separated origins of the Netlify frontends allowed to call the API:
CORS_ALLOWED_ORIGINS=https://admin.example.com,https://app.example.com,https://merchant.example.com
