# Test accounts for persona agents. Copy to secrets.env (gitignored).
# Agents never see these values: they type the NAME and Playwright MCP fills in the value.
# Use test accounts only, on a test brand/outlet. Never use real merchant or customer accounts.
ADMIN_EMAIL=
ADMIN_PASSWORD=
OWNER_EMAIL=
OWNER_PASSWORD=
POS_EMAIL=
POS_PASSWORD=
POS_BARBER_PIN=
CUSTOMER_EMAIL=
CUSTOMER_PASSWORD=
